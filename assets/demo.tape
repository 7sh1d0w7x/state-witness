Output assets/demo.gif

Set Shell "bash"
Set FontSize 15
Set Width 1000
Set Height 420
Set Padding 20
Set Margin 10
Set MarginFill "#0b1120"
Set WindowBar Colorful
Set Theme "Dracula"

# typing rapid al comenzii
Set TypingSpeed 0ms
Type "cat assets/demo-output.txt"
Sleep 200ms
Enter
Sleep 3000ms

Type "clear"
Enter
Sleep 300ms
Type "cat assets/demo-output.json"
Sleep 200ms
Enter
Sleep 3500ms
